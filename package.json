{
  "name": "batcoif-launcher",
  "version": "1.2.0",
  "description": "Batcoif Launcher - a simple game launcher",
  "main": "src/main.js",
  "author": "batcoif",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "online.batcoif.launcher",
    "productName": "Batcoif Launcher",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "BatcoifLauncher.exe",
      "signAndEditExecutable": false
    }
  }
}